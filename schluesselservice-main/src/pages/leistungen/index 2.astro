---
import BaseLayout from '../../layouts/BaseLayout.astro';
import EmergencyBanner from '../../components/EmergencyBanner.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { SERVICES } from '../../data/services';
import { jsonLd } from '../../lib/jsonld';

const firmName = 'Schlüsseldienst Schmidt';
const phone = '+49 201 000000';
const phoneDisplay = '0201 000000';
const siteUrl = 'https://www.IHRE-DOMAIN.de';
const pageUrl = `${siteUrl}/leistungen`;

const title = `Leistungen – Türöffnung, Schlösser & Sicherheitstechnik`;
const description = `Türöffnung, Tresoröffnung, Schlossaustausch, Einbruchschutz und Schließanlagen vom Fachbetrieb. 24h Notdienst — jetzt anrufen: ${phoneDisplay}`;

const allServices = [
  {
    slug: 'tueroeffnung',
    icon: '🚪',
    shortName: 'Türöffnung Notdienst',
    cardText: 'Ausgesperrt? Unsere ausgebildeten Schlosser öffnen Wohnungstüren, Haustüren und Bürotüren zerstörungsfrei — in unter 15 Minuten vor Ort.',
  },
  ...SERVICES.map(s => ({ slug: s.slug, icon: s.icon, shortName: s.shortName, cardText: s.cardText })),
];

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Startseite', item: siteUrl },
    { '@type': 'ListItem', position: 2, name: 'Leistungen', item: pageUrl },
  ],
};

const itemListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Leistungen Schlüsseldienst Schmidt',
  itemListElement: allServices.map((s, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: s.shortName,
    url: `${siteUrl}/leistungen/${s.slug}`,
  })),
};
---

<BaseLayout title={title} description={description} canonical={pageUrl} schema={itemListSchema}>
  <script type="application/ld+json" slot="head" set:html={jsonLd(breadcrumbSchema)} />
  <EmergencyBanner />
  <Header />

  <!-- Hero -->
  <section class="bg-gradient-to-br from-gray-900 via-gray-800 to-orange-900 text-white py-16 md:py-24">
    <div class="container-main text-center max-w-2xl">
      <div class="inline-flex items-center gap-2 bg-white/5 border border-white/10 rounded-full px-4 py-1.5 text-gray-400 text-xs font-medium mb-7 tracking-wide uppercase">
        <span class="w-1.5 h-1.5 bg-green-400 rounded-full animate-pulse"></span>
        Telefonisch erreichbar — 24h Notdienst
      </div>
      <h1 class="text-3xl md:text-5xl font-black mb-4 tracking-tight">Leistungen rund um Tür, Schloss und Tresor</h1>
      <p class="text-base text-gray-400 leading-relaxed">
        Vom Notfall bis zur Sicherheitslösung — alles rund um Schloss, Tür und Tresor in Essen und ganz NRW.
      </p>
    </div>
  </section>

  <!-- Breadcrumb -->
  <nav aria-label="Brotkrumennavigation" class="bg-gray-50 border-b border-gray-100">
    <div class="container-main py-3 text-xs text-gray-500">
      <a href="/" class="hover:text-orange-600 transition-colors">Startseite</a>
      <span class="mx-2 text-gray-300">/</span>
      <span class="text-gray-700 font-medium">Leistungen</span>
    </div>
  </nav>

  <main class="py-16 bg-white">
    <div class="container-main max-w-5xl">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {allServices.map(s => (
          <a
            href={`/leistungen/${s.slug}`}
            class="bg-white rounded-xl border border-gray-200 p-6 shadow-sm hover:shadow-md hover:border-orange-400 transition-all block"
          >
            <div class="text-4xl mb-4">{s.icon}</div>
            <h2 class="text-xl font-bold text-gray-900 mb-2">{s.shortName}</h2>
            <p class="text-gray-600 text-sm mb-4">{s.cardText}</p>
            <span class="text-orange-600 font-semibold text-sm">Mehr erfahren →</span>
          </a>
        ))}
      </div>

      <!-- Anruf-CTA -->
      <div class="bg-orange-50 border border-orange-200 rounded-2xl p-8 text-center mt-12">
        <p class="text-gray-900 font-bold text-lg mb-2">Beratung und Auftragsannahme ausschließlich telefonisch</p>
        <p class="text-gray-600 text-sm mb-5 max-w-xl mx-auto">
          Schildern Sie uns Ihren Fall — wir sagen Ihnen direkt, was zu tun ist, wie schnell wir da sind und was es kostet.
        </p>
        <a href={`tel:${phone}`} class="btn-call justify-center inline-flex">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24">
            <path d="M6.6 10.8c1.4 2.8 3.8 5.1 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1-9.4 0-17-7.6-17-17 0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.3 0 .7-.2 1L6.6 10.8z"/>
          </svg>
          {phoneDisplay}
        </a>
        <p class="mt-3 text-xs text-gray-500">24 Stunden täglich, 365 Tage im Jahr — auch an Feiertagen</p>
      </div>
    </div>
  </main>

  <Footer />
</BaseLayout>
