---
import BaseLayout from '../../layouts/BaseLayout.astro';
import EmergencyBanner from '../../components/EmergencyBanner.astro';
import Header from '../../components/Header.astro';
import FaqAccordion from '../../components/FaqAccordion.astro';
import Footer from '../../components/Footer.astro';
import HeroBackdrop from '../../components/HeroBackdrop.astro';
import { SERVICES } from '../../data/services';
import { jsonLd } from '../../lib/jsonld';

export function getStaticPaths() {
  return SERVICES.map(service => ({
    params: { service: service.slug },
    props: { service },
  }));
}

const { service } = Astro.props;
const firmName = 'Schlüsseldienst Schmidt';
const phone = '+49 155 11447266';
const phoneDisplay = '0155 11447266';
const siteUrl = 'https://www.IHRE-DOMAIN.de';
const pageUrl = `${siteUrl}/leistungen/${service.slug}`;

// Die Titles in services.ts enthalten Keyword + Region bereits; kein Marken-Suffix,
// damit die Titles unter ~60 Zeichen bleiben.
const title = service.title;

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: service.name,
  serviceType: service.shortName,
  description: service.description,
  url: pageUrl,
  provider: {
    '@type': ['Locksmith', 'LocalBusiness'],
    name: firmName,
    telephone: phone,
    url: siteUrl,
    priceRange: '€€',
    openingHours: 'Mo-Su 00:00-24:00',
  },
  areaServed: {
    '@type': 'GeoCircle',
    geoMidpoint: {
      '@type': 'GeoCoordinates',
      latitude: 51.4556,
      longitude: 7.0116,
    },
    geoRadius: '100000',
  },
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Startseite', item: siteUrl },
    { '@type': 'ListItem', position: 2, name: 'Leistungen', item: `${siteUrl}/leistungen` },
    { '@type': 'ListItem', position: 3, name: service.shortName, item: pageUrl },
  ],
};

const otherServices = SERVICES.filter(s => s.slug !== service.slug);
---

<BaseLayout title={title} description={service.description} canonical={pageUrl} schema={serviceSchema}>
  <script type="application/ld+json" slot="head" set:html={jsonLd(breadcrumbSchema)} />
  <EmergencyBanner />
  <Header />

  <!-- Hero -->
  <section class="relative overflow-hidden bg-gradient-to-br from-gray-900 via-gray-800 to-orange-900 text-white py-16 md:py-24">
    <HeroBackdrop
      base={`/images/leistungen/${service.heroImage.base}`}
      widths={[800, 1400]}
      width={1400}
      height={1050}
      alt={service.heroImage.alt}
      objectPosition={service.heroImage.objectPosition}
      overlay={service.heroImage.overlay}
    />
    <div class="relative container-main text-center max-w-2xl">
      <div class="inline-flex items-center gap-2 bg-white/5 border border-white/10 rounded-full px-4 py-1.5 text-gray-400 text-xs font-medium mb-7 tracking-wide uppercase">
        <span class="w-1.5 h-1.5 bg-green-400 rounded-full animate-pulse"></span>
        Telefonisch erreichbar — 24h Notdienst
      </div>
      <h1 class="text-3xl md:text-5xl font-black mb-4 tracking-tight leading-tight">
        {service.heroLine1}<br /><span class="text-orange-500">{service.heroLine2}</span>
      </h1>
      <p class="text-base text-gray-400 mb-10 leading-relaxed">{service.heroSub}</p>
      <a href={`tel:${phone}`} class="bg-orange-600 hover:bg-orange-700 text-white font-bold py-4 px-8 rounded-xl transition-colors inline-flex items-center gap-2 text-lg shadow-lg shadow-orange-900/30">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24">
          <path d="M6.6 10.8c1.4 2.8 3.8 5.1 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1-9.4 0-17-7.6-17-17 0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.3 0 .7-.2 1L6.6 10.8z"/>
        </svg>
        {phoneDisplay}
      </a>
      <p class="mt-4 text-xs text-gray-500">Beratung und Auftragsannahme ausschließlich telefonisch.</p>
    </div>
  </section>

  <!-- Breadcrumb -->
  <nav aria-label="Brotkrumennavigation" class="bg-gray-50 border-b border-gray-100">
    <div class="container-main py-3 text-xs text-gray-500">
      <a href="/leistungen" class="hover:text-orange-600 transition-colors">Leistungen</a>
      <span class="mx-2 text-gray-300">/</span>
      <span class="text-gray-700 font-medium">{service.shortName}</span>
    </div>
  </nav>

  <!-- Intro -->
  <section class="py-16 bg-white">
    <div class="container-main max-w-3xl">
      <h2 class="section-title">{service.introHeading}</h2>
      <div class="text-gray-700 space-y-4 leading-relaxed">
        {service.introParagraphs.map(p => <p set:html={p} />)}
      </div>

      <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mt-10">
        {service.kpis.map(item => (
          <div class="text-center bg-orange-50 rounded-xl p-5 border border-orange-100">
            <div class="text-xl font-black text-orange-600">{item.value}</div>
            <div class="text-sm text-gray-600 mt-1">{item.label}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Anwendungsfälle -->
  <section class="py-16 bg-gray-50">
    <div class="container-main max-w-5xl">
      <h2 class="section-title text-center mb-10">{service.casesHeading}</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
        {service.cases.map(item => (
          <div class="bg-white rounded-xl border border-gray-200 p-6">
            <h3 class="font-bold text-gray-900 mb-2">{item.title}</h3>
            <p class="text-gray-600 text-sm leading-relaxed">{item.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Ablauf -->
  <section class="py-16 bg-white">
    <div class="container-main max-w-3xl">
      <h2 class="section-title text-center mb-10">{service.stepsHeading}</h2>
      <div class="space-y-6">
        {service.steps.map((item, i) => (
          <div class="flex gap-5">
            <div class="flex-shrink-0 w-12 h-12 bg-orange-600 text-white rounded-full flex items-center justify-center font-black text-xl">
              {i + 1}
            </div>
            <div>
              <h3 class="font-bold text-gray-900 mb-1">{item.title}</h3>
              <p class="text-gray-600 text-sm leading-relaxed">{item.text}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Kosten & Anruf-CTA -->
  <section class="py-16 bg-gray-50">
    <div class="container-main max-w-3xl">
      <h2 class="section-title text-center mb-4">Transparente Kosten</h2>
      <p class="text-center text-gray-600 mb-8">{service.costText}</p>
      <div class="bg-orange-50 border border-orange-200 rounded-2xl p-6 text-center">
        <p class="text-gray-700 font-semibold mb-2">Preisauskunft am Telefon</p>
        <p class="text-gray-600 text-sm">Schildern Sie uns Ihren Fall — wir nennen Ihnen den Preisrahmen, bevor ein Techniker losfährt.</p>
        <a href={`tel:${phone}`} class="btn-call justify-center inline-flex mt-4">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24">
            <path d="M6.6 10.8c1.4 2.8 3.8 5.1 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1-9.4 0-17-7.6-17-17 0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.3 0 .7-.2 1L6.6 10.8z"/>
          </svg>
          {phoneDisplay}
        </a>
        <p class="mt-3 text-xs text-gray-500">24 Stunden täglich, 365 Tage im Jahr</p>
      </div>
    </div>
  </section>

  <FaqAccordion items={service.faq} city="Essen" />

  <!-- Weitere Leistungen -->
  <section class="py-16 bg-gray-50">
    <div class="container-main max-w-5xl">
      <h2 class="section-title text-center mb-10">Weitere Leistungen</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
        <a href="/leistungen/tueroeffnung" class="bg-white rounded-xl border border-gray-200 p-6 hover:border-orange-400 transition-colors block">
          <div class="text-3xl mb-3">🚪</div>
          <h3 class="font-bold text-gray-900 mb-1">Türöffnung Notdienst</h3>
          <p class="text-gray-600 text-sm">Zerstörungsfreie Öffnung bei Aussperrung — 24h.</p>
        </a>
        {otherServices.map(s => (
          <a href={`/leistungen/${s.slug}`} class="bg-white rounded-xl border border-gray-200 p-6 hover:border-orange-400 transition-colors block">
            <div class="text-3xl mb-3">{s.icon}</div>
            <h3 class="font-bold text-gray-900 mb-1">{s.shortName}</h3>
            <p class="text-gray-600 text-sm">{s.cardText.split('.')[0]}.</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <Footer />
</BaseLayout>
