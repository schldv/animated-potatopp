---
import BaseLayout from '../../layouts/BaseLayout.astro';
import EmergencyBanner from '../../components/EmergencyBanner.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { CITIES } from '../../data/cities';
import { CITY_SERVICES } from '../../data/services';
import { jsonLd } from '../../lib/jsonld';
import { responseTimeFor } from '../../lib/cityService';

export function getStaticPaths() {
  return CITIES.map(city => ({ params: { city: city.slug }, props: { city } }));
}

const { city } = Astro.props;
const firmName = 'Schlüsseldienst Schmidt';
const phone = '+49 155 11447266';
const phoneDisplay = '0155 11447266';
const siteUrl = 'https://www.IHRE-DOMAIN.de';
const pageUrl = `${siteUrl}/${city.slug}/kontakt`;

const title = `Kontakt – Schlüsseldienst ${city.name}, 24h Notdienst`;
const description = `Schlüsseldienst ${city.name} rund um die Uhr telefonisch erreichbar: ${phoneDisplay}. Preisauskunft vor dem Einsatz, Einsatz im gesamten Stadtgebiet.`;

const responseTime = responseTimeFor(city);
const isHq = city.distanceKm === 0;

const contactSchema = {
  '@context': 'https://schema.org',
  '@type': ['Locksmith', 'LocalBusiness'],
  name: firmName,
  telephone: phone,
  url: pageUrl,
  priceRange: '€€',
  openingHours: 'Mo-Su 00:00-24:00',
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Essen',
    addressRegion: 'Nordrhein-Westfalen',
    addressCountry: 'DE',
  },
  areaServed: {
    '@type': 'City',
    name: city.name,
    geo: { '@type': 'GeoCoordinates', latitude: city.geo.lat, longitude: city.geo.lng },
  },
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Startseite', item: siteUrl },
    { '@type': 'ListItem', position: 2, name: `Schlüsseldienst ${city.name}`, item: `${siteUrl}/${city.slug}` },
    { '@type': 'ListItem', position: 3, name: `Kontakt ${city.name}`, item: pageUrl },
  ],
};
---

<BaseLayout title={title} description={description} canonical={pageUrl} schema={contactSchema} city={city.name}>
  <script type="application/ld+json" slot="head" set:html={jsonLd(breadcrumbSchema)} />
  <EmergencyBanner city={city.name} />
  <Header city={city.name} citySlug={city.slug} />

  <!-- Hero -->
  <section class="bg-gradient-to-br from-gray-900 via-gray-800 to-orange-900 text-white py-16 md:py-24">
    <div class="container-main text-center max-w-2xl">
      <div class="inline-flex items-center gap-2 bg-white/5 border border-white/10 rounded-full px-4 py-1.5 text-gray-400 text-xs font-medium mb-7 tracking-wide uppercase">
        <span class="w-1.5 h-1.5 bg-green-400 rounded-full animate-pulse"></span>
        Notdienst aktiv — sofort erreichbar
      </div>
      <h1 class="text-3xl md:text-5xl font-black mb-4 tracking-tight leading-tight">
        Kontakt <span class="text-orange-500">{city.name}</span>
      </h1>
      <p class="text-base text-gray-400 leading-relaxed">
        Wir arbeiten ohne Kontaktformular. Rufen Sie an — rund um die Uhr, auch nachts und an Feiertagen.
      </p>
    </div>
  </section>

  <!-- Breadcrumb -->
  <nav aria-label="Brotkrumennavigation" class="bg-gray-50 border-b border-gray-100">
    <div class="container-main py-3 text-xs text-gray-500">
      <a href={`/${city.slug}`} class="hover:text-orange-600 transition-colors">Schlüsseldienst {city.name}</a>
      <span class="mx-2 text-gray-300">/</span>
      <span class="text-gray-700 font-medium">Kontakt</span>
    </div>
  </nav>

  <main class="py-16 bg-white">
    <div class="container-main max-w-2xl">

      <!-- Notruf -->
      <div class="border border-orange-200 bg-orange-50 rounded-2xl p-8 md:p-10 text-center">
        <div class="w-12 h-12 bg-orange-600 rounded-xl flex items-center justify-center mx-auto mb-5">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-white" fill="currentColor" viewBox="0 0 24 24">
            <path d="M6.6 10.8c1.4 2.8 3.8 5.1 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1-9.4 0-17-7.6-17-17 0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.3 0 .7-.2 1L6.6 10.8z"/>
          </svg>
        </div>
        <p class="text-xs font-semibold uppercase tracking-wide text-gray-500 mb-2">Notfall in {city.name} — sofort anrufen</p>
        <a href={`tel:${phone}`} class="text-4xl md:text-5xl font-black text-orange-600 hover:text-orange-700 transition-colors block tracking-tight">
          {phoneDisplay}
        </a>
        <p class="text-sm text-gray-600 mt-4">24 Stunden täglich · 365 Tage im Jahr · auch an Feiertagen</p>
      </div>

      <!-- Anfahrt nach dieser Stadt -->
      <div class="mt-10 border border-gray-200 rounded-2xl p-8">
        <h2 class="font-bold text-gray-900 text-lg mb-3">Anfahrt nach {city.name}</h2>
        <p class="text-gray-600 text-sm leading-relaxed">
          {isHq
            ? `${city.name} ist unser Hauptstandort — hier sind wir am schnellsten vor Ort. Im Stadtgebiet trifft unser Techniker häufig innerhalb von unter 15 Minuten bei Ihnen ein.`
            : `Von unserem Standort in Essen sind es ${city.distanceKm} km nach ${city.name}. Als Richtwert für die Anfahrt planen Sie ${responseTime} ein — die tatsächliche Zeit hängt von Verkehrslage und Tageszeit ab. Beim Anruf nennen wir Ihnen einen konkreten Zeitrahmen.`}
        </p>
        {city.districts && city.districts.length > 0 && (
          <div class="mt-5">
            <h3 class="font-semibold text-gray-900 text-sm mb-3">Stadtteile in {city.name} — alle abgedeckt:</h3>
            <div class="flex flex-wrap gap-2">
              {city.districts.map(d => (
                <span class="bg-orange-50 border border-orange-200 text-orange-700 text-sm font-medium px-3 py-1 rounded-full">{d}</span>
              ))}
            </div>
          </div>
        )}
      </div>

      <!-- Warum nur telefonisch -->
      <div class="mt-6 border border-gray-200 rounded-2xl p-8">
        <h2 class="font-bold text-gray-900 text-lg mb-3">Beratung und Auftragsannahme ausschließlich telefonisch</h2>
        <p class="text-gray-600 text-sm leading-relaxed">
          Wir bieten bewusst kein Kontaktformular an. Bei einem Schloss- oder Türproblem kommt es auf Tempo und
          Rückfragen an: Türtyp, Schlossart, Ort und Dringlichkeit klären sich in einem kurzen Telefonat in
          Sekunden — und Sie erhalten sofort eine verbindliche Preisauskunft.
        </p>
        <ul class="mt-5 space-y-2.5 text-sm text-gray-700">
          {[
            'Sofortige Preisauskunft — noch bevor ein Techniker losfährt',
            `Direkte Einschätzung, wie schnell wir in ${city.name} bei Ihnen sein können`,
            'Keine Wartezeit auf eine Rückmeldung, kein Rückrufversprechen',
            'Keine Speicherung von Formulardaten bei Drittanbietern',
          ].map(item => (
            <li class="flex gap-2.5 items-start">
              <span class="text-orange-600 font-bold flex-shrink-0">✓</span>
              <span>{item}</span>
            </li>
          ))}
        </ul>
      </div>

      <!-- Was bereithalten -->
      <div class="mt-6 border border-gray-200 rounded-2xl p-8">
        <h2 class="font-bold text-gray-900 text-lg mb-3">Das sollten Sie beim Anruf bereithalten</h2>
        <ul class="space-y-2.5 text-sm text-gray-700">
          {[
            `Ihre Adresse in ${city.name} und wie wir zur Tür gelangen (Etage, Hinterhof, Klingelschild)`,
            'Um welche Tür es geht: Wohnungstür, Haustür, Bürotür, Tresor',
            'Ob der Schlüssel abgebrochen, verloren oder nur innen stecken geblieben ist',
            'Einen Lichtbildausweis für die Berechtigungsprüfung vor Ort',
          ].map(item => (
            <li class="flex gap-2.5 items-start">
              <span class="text-gray-400 flex-shrink-0">•</span>
              <span>{item}</span>
            </li>
          ))}
        </ul>
      </div>

      <p class="mt-8 text-center text-xs text-gray-400">
        Firmenanschrift und alle Pflichtangaben finden Sie im <a href="/impressum" class="text-orange-600 hover:underline">Impressum</a>.
      </p>
    </div>
  </main>

  <!-- Leistungen dieser Stadt -->
  <section class="py-16 bg-gray-50">
    <div class="container-main max-w-5xl">
      <h2 class="section-title text-center mb-10">Unsere Leistungen in {city.name}</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
        {CITY_SERVICES.map(s => (
          <a href={`/${city.slug}/${s.slug}`} class="bg-white rounded-xl border border-gray-200 p-6 hover:border-orange-400 transition-colors block">
            <div class="text-3xl mb-3">{s.icon}</div>
            <h3 class="font-bold text-gray-900 mb-1">{s.shortName} {city.name}</h3>
            <p class="text-gray-600 text-sm">{s.cardText.split('.')[0]}.</p>
          </a>
        ))}
      </div>
      <p class="text-center mt-8 text-sm text-gray-600">
        <a href={`/${city.slug}/faq`} class="text-orange-600 font-semibold hover:underline">Häufige Fragen zu {city.name} →</a>
      </p>
    </div>
  </section>

  <Footer city={city.name} citySlug={city.slug} />
</BaseLayout>
