---
import BaseLayout from '../layouts/BaseLayout.astro';
import EmergencyBanner from '../components/EmergencyBanner.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { CITIES } from '../data/cities';

const firmName = 'Schlüsseldienst Schmidt';
const siteUrl = 'https://www.IHRE-DOMAIN.de';
const title = `Einsatzgebiet – Schlüsseldienst in 68 Städten in NRW`;
const description = `Alle Städte im Einsatzgebiet unseres Schlüsseldienstes: Ruhrgebiet, Düsseldorf, Köln, Wuppertal, Münster und 70+ weitere Städte in NRW. Türöffnung 24h.`;

const regions = [...new Set(CITIES.map(c => c.region))];
const noindex = true;
---

<BaseLayout title={title} description={description} canonical={`${siteUrl}/schluessel-regionen`} noindex={noindex}>
  <EmergencyBanner />
  <Header />

  <main class="py-16">
    <div class="container-main">
      <h1 class="section-title text-center mb-4">Unser Einsatzgebiet: {CITIES.length} Städte in NRW</h1>
      <p class="text-center text-gray-600 max-w-2xl mx-auto mb-14">
        Wir decken alle Städte und Gemeinden mit 10.000+ Einwohnern im 100km-Umkreis von Essen ab.
        Wählen Sie Ihre Stadt für lokale Preise und Informationen.
      </p>

      {regions.map(region => (
        <div class="mb-14">
          <h2 class="text-2xl font-bold text-gray-900 mb-6 pb-3 border-b border-gray-200">
            {region}
            <span class="ml-3 text-sm font-normal text-gray-500">
              ({CITIES.filter(c => c.region === region).length} Städte)
            </span>
          </h2>
          <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-3">
            {CITIES.filter(c => c.region === region).map(city => (
              <a
                href={`/${city.slug}`}
                class="bg-white border border-gray-200 rounded-xl p-4 hover:border-orange-400 hover:shadow-md transition-all group"
              >
                <div class="font-semibold text-gray-900 group-hover:text-orange-600 text-sm mb-1">{city.name}</div>
                <div class="text-xs text-gray-400">{city.distanceKm}km · {city.population.toLocaleString('de-DE')} Einw.</div>
              </a>
            ))}
          </div>
        </div>
      ))}
    </div>
  </main>

  <Footer />
</BaseLayout>
