---
interface Props {
  city?: string;
  /** Gesetzt auf Stadtseiten und deren Leistungs-Unterseiten. */
  citySlug?: string;
}

const { city = 'Essen', citySlug } = Astro.props;
const phone = '+49 201 000000';
const phoneDisplay = '0201 000000';

// Im Stadtkontext bleibt die Navigation in dieser Stadt. Sonst landet ein
// Besucher von /marl über "Türöffnung" auf der Essen-lastigen Hauptseite —
// und die generischen Leistungsseiten sammeln die interne Linkkraft ein,
// die eigentlich den Stadtseiten zusteht.
const navLinks = citySlug
  ? [
      { href: `/${citySlug}`, label: city },
      { href: `/${citySlug}/tueroeffnung`, label: 'Türöffnung' },
      { href: `/${citySlug}/einbruchschutz`, label: 'Einbruchschutz' },
      { href: `/${citySlug}/faq`, label: 'FAQ' },
      { href: `/${citySlug}/kontakt`, label: 'Kontakt' },
    ]
  : [
      { href: '/', label: 'Startseite' },
      { href: '/leistungen', label: 'Leistungen' },
      { href: '/leistungen/tueroeffnung', label: 'Türöffnung' },
      { href: '/faq', label: 'FAQ' },
      { href: '/kontakt', label: 'Kontakt' },
    ];
---

<header class="bg-white border-b border-gray-100">
  <div class="container-main py-4 flex items-center justify-between gap-6">
    <!-- Logo -->
    <a href="/" class="flex items-center gap-3 flex-shrink-0" aria-label="Startseite">
      <div class="w-9 h-9 bg-orange-600 rounded-lg flex items-center justify-center flex-shrink-0">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z" />
        </svg>
      </div>
      <div>
        <span class="text-base font-black text-gray-900 leading-tight block">Schlüsseldienst Schmidt</span>
        <span class="text-xs text-gray-400 font-medium">{city} & Umgebung</span>
      </div>
    </a>

    <!-- Desktop Nav -->
    <nav class="hidden lg:flex items-center gap-8" aria-label="Hauptnavigation">
      {navLinks.map(link => (
        <a href={link.href} class="text-sm font-medium text-gray-600 hover:text-gray-900 transition-colors">
          {link.label}
        </a>
      ))}
    </nav>

    <!-- CTA -->
    <a
      href={`tel:${phone}`}
      class="bg-orange-600 hover:bg-orange-700 text-white font-semibold py-2.5 px-5 rounded-lg transition-colors flex items-center gap-2 text-sm flex-shrink-0"
      aria-label={`Jetzt anrufen ${phoneDisplay}`}
    >
      <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 flex-shrink-0" fill="currentColor" viewBox="0 0 24 24">
        <path d="M6.6 10.8c1.4 2.8 3.8 5.1 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1-9.4 0-17-7.6-17-17 0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.3 0 .7-.2 1L6.6 10.8z"/>
      </svg>
      <span class="hidden sm:inline">{phoneDisplay}</span>
      <span class="sm:hidden">Anrufen</span>
    </a>
  </div>
</header>
