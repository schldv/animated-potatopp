---
interface Props {
  city?: string;
}

const { city = 'Essen' } = Astro.props;
const phone = '+49 155 11447266';
const phoneDisplay = '0155 11447266';
---

<div id="emergency-banner" class="bg-gray-950 border-b border-gray-800 text-white" style="display:none">
  <div class="container-main py-2.5 flex items-center justify-between gap-4">
    <div class="flex items-center gap-2.5">
      <span class="w-1.5 h-1.5 bg-green-400 rounded-full animate-pulse hidden sm:block flex-shrink-0"></span>
      <p class="text-sm text-gray-400 hidden sm:block">
        24h Notdienst — Schlüsseldienst Schmidt, {city} & Umgebung
      </p>
    </div>
    <a
      href={`tel:${phone}`}
      class="flex items-center gap-2 bg-orange-600 hover:bg-orange-700 text-white font-semibold py-1.5 px-4 rounded-lg text-sm transition-colors ml-auto"
      aria-label={`Jetzt anrufen: ${phoneDisplay}`}
    >
      <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="currentColor" viewBox="0 0 24 24">
        <path d="M6.6 10.8c1.4 2.8 3.8 5.1 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1-9.4 0-17-7.6-17-17 0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.3 0 .7-.2 1L6.6 10.8z"/>
      </svg>
      {phoneDisplay}
    </a>
  </div>
</div>

<script>
  const banner = document.getElementById('emergency-banner');
  const header = document.querySelector('header');

  if (banner && header) {
    const observer = new IntersectionObserver(([entry]) => {
      if (!entry.isIntersecting) {
        banner.style.cssText = 'display:block;position:fixed;top:0;left:0;right:0;z-index:50;';
      } else {
        banner.style.cssText = 'display:none;';
      }
    }, { threshold: 0 });

    observer.observe(header);
  }
</script>
