---
interface Props {
  city?: string;
  /** Gesetzt auf Stadtseiten und deren Leistungs-Unterseiten. */
  citySlug?: string;
}

const { city = 'Essen', citySlug } = Astro.props;
const phone = '+49 155 11447266';
const phoneDisplay = '0155 11447266';

// Im Stadtkontext bleibt die Navigation in dieser Stadt. Sonst landet ein
// Besucher von /marl über "Türöffnung" auf der Essen-lastigen Hauptseite —
// und die generischen Leistungsseiten sammeln die interne Linkkraft ein,
// die eigentlich den Stadtseiten zusteht.
const navLinks = citySlug
  ? [
      { href: `/${citySlug}`, label: city },
      { href: `/${citySlug}/tueroeffnung`, label: 'Türöffnung' },
      { href: `/${citySlug}/einbruchschutz`, label: 'Einbruchschutz' },
      { href: `/${citySlug}/faq`, label: 'FAQ' },
      { href: `/${citySlug}/kontakt`, label: 'Kontakt' },
    ]
  : [
      { href: '/', label: 'Startseite' },
      { href: '/leistungen', label: 'Leistungen' },
      { href: '/leistungen/tueroeffnung', label: 'Türöffnung' },
      { href: '/faq', label: 'FAQ' },
      { href: '/kontakt', label: 'Kontakt' },
    ];
---

<header class="bg-white border-b border-gray-100">
  <div class="container-main py-4 flex items-center justify-between gap-6">
    <!-- Logo -->
    <a href={citySlug ? `/${citySlug}` : '/'} class="flex items-center gap-3 flex-shrink-0" aria-label="Startseite">
      <div class="w-9 h-9 bg-orange-600 rounded-lg flex items-center justify-center flex-shrink-0">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z" />
        </svg>
      </div>
      <div>
        <span class="text-base font-black text-gray-900 leading-tight block">Schlüsseldienst Schmidt</span>
        <span class="text-xs text-gray-400 font-medium">{city} & Umgebung</span>
      </div>
    </a>

    <!-- Desktop Nav -->
    <nav class="hidden lg:flex items-center gap-8" aria-label="Hauptnavigation">
      {navLinks.map(link => (
        <a href={link.href} class="text-sm font-medium text-gray-600 hover:text-gray-900 transition-colors">
          {link.label}
        </a>
      ))}
    </nav>

    <!-- CTA + Hamburger -->
    <div class="flex items-center gap-3">
      <a
        href={`tel:${phone}`}
        class="bg-orange-600 hover:bg-orange-700 text-white font-semibold py-2.5 px-5 rounded-lg transition-colors flex items-center gap-2 text-sm flex-shrink-0"
        aria-label={`Jetzt anrufen ${phoneDisplay}`}
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 flex-shrink-0" fill="currentColor" viewBox="0 0 24 24">
          <path d="M6.6 10.8c1.4 2.8 3.8 5.1 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1-9.4 0-17-7.6-17-17 0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.3 0 .7-.2 1L6.6 10.8z"/>
        </svg>
        <span class="hidden sm:inline">{phoneDisplay}</span>
        <span class="sm:hidden">Anrufen</span>
      </a>

      <!-- Hamburger Button (nur mobile) -->
      <button
        id="nav-open"
        class="lg:hidden p-2 rounded-lg text-gray-600 hover:text-gray-900 hover:bg-gray-100 transition-colors"
        aria-label="Menü öffnen"
        aria-expanded="false"
        aria-controls="mobile-drawer"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
  </div>
</header>

<!-- Overlay -->
<div
  id="nav-overlay"
  class="fixed inset-0 bg-black/50 z-40 hidden"
  aria-hidden="true"
></div>

<!-- Mobile Drawer -->
<nav
  id="mobile-drawer"
  class="fixed top-0 right-0 h-full w-72 bg-white z-50 shadow-2xl transform translate-x-full transition-transform duration-300 ease-in-out flex flex-col"
  aria-label="Mobile Navigation"
>
  <!-- Drawer Header -->
  <div class="flex items-center justify-between px-5 py-4 border-b border-gray-100">
    <div class="flex items-center gap-3">
      <div class="w-8 h-8 bg-orange-600 rounded-lg flex items-center justify-center flex-shrink-0">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z" />
        </svg>
      </div>
      <span class="text-sm font-black text-gray-900">Schlüsseldienst Schmidt</span>
    </div>
    <button
      id="nav-close"
      class="p-2 rounded-lg text-gray-400 hover:text-gray-900 hover:bg-gray-100 transition-colors"
      aria-label="Menü schließen"
    >
      <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>

  <!-- Nav Links -->
  <ul class="flex flex-col py-3 flex-1 overflow-y-auto">
    {navLinks.map(link => (
      <li>
        <a
          href={link.href}
          class="flex items-center gap-3 px-5 py-3.5 text-gray-700 hover:text-orange-600 hover:bg-orange-50 transition-colors font-medium"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-gray-400 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
          </svg>
          {link.label}
        </a>
      </li>
    ))}
  </ul>

  <!-- Drawer Footer: Anruf-Button -->
  <div class="px-5 py-5 border-t border-gray-100">
    <a
      href={`tel:${phone}`}
      class="flex items-center justify-center gap-2 w-full bg-orange-600 hover:bg-orange-700 text-white font-semibold py-3 px-5 rounded-lg transition-colors text-sm"
    >
      <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 flex-shrink-0" fill="currentColor" viewBox="0 0 24 24">
        <path d="M6.6 10.8c1.4 2.8 3.8 5.1 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1-9.4 0-17-7.6-17-17 0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.3 0 .7-.2 1L6.6 10.8z"/>
      </svg>
      {phoneDisplay} – Jetzt anrufen
    </a>
    <p class="text-center text-xs text-gray-400 mt-2">24h Notdienst · unter 10 Min.</p>
  </div>
</nav>

<script>
  const openBtn = document.getElementById('nav-open');
  const closeBtn = document.getElementById('nav-close');
  const overlay = document.getElementById('nav-overlay');
  const drawer = document.getElementById('mobile-drawer');

  function openDrawer() {
    drawer?.classList.remove('translate-x-full');
    overlay?.classList.remove('hidden');
    openBtn?.setAttribute('aria-expanded', 'true');
    document.body.style.overflow = 'hidden';
  }

  function closeDrawer() {
    drawer?.classList.add('translate-x-full');
    overlay?.classList.add('hidden');
    openBtn?.setAttribute('aria-expanded', 'false');
    document.body.style.overflow = '';
  }

  openBtn?.addEventListener('click', openDrawer);
  closeBtn?.addEventListener('click', closeDrawer);
  overlay?.addEventListener('click', closeDrawer);

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeDrawer();
  });
</script>
