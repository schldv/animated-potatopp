{
  "name": "schluesselservice",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && find dist -name '.DS_Store' -delete",
    "preview": "astro preview",
    "astro": "astro",
    "check:csp": "node scripts/check-csp.mjs",
    "verify": "npm run build && npx astro check && npm run check:csp && npm run audit:links && npm test",
    "audit:links": "node scripts/audit-links.mjs",
    "test:security": "node scripts/test-security.mjs",
    "test:performance": "node scripts/test-performance.mjs",
    "test:seo": "node scripts/test-seo.mjs",
    "test": "npm run test:security && npm run test:performance && npm run test:seo"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "@tailwindcss/vite": "^4.3.1",
    "astro": "^6.4.7",
    "tailwindcss": "^4.3.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "typescript": "^6.0.3"
  }
}
